# Ghostfolio Docker config.
# Copy to .env and fill in. .env is git-ignored; never commit it.
#
# IMPORTANT: use `openssl rand -hex 32` for ALL of these. Hex output is
# alphanumeric (0-9, a-f) and is always safe inside a DATABASE_URL.
# Do NOT use `-base64` — base64 can produce '/', '+', '=' which break URL parsing
# (Prisma will fail with P1001 even though Postgres is healthy).

ACCESS_TOKEN_SALT=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
