<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Second Opinion{% endblock %}</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f7f7f7; margin: 0; padding: 20px; color: #2c3e50;">
  <div style="max-width: 720px; margin: 0 auto;">
    <div style="margin-bottom: 16px; font-size: 13px;">
      <a href="/history" style="color: #2c3e50; text-decoration: none;">&larr; All history</a>
    </div>
    <div style="background: #fff; border-radius: 8px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,.06);">
      {% block content %}{% endblock %}
    </div>
  </div>
</body>
</html>
