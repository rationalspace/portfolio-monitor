<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Weekly portfolio digest</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f7f7f7; margin: 0; padding: 20px;">
  <div style="max-width: 700px; margin: 0 auto; background: #fff; border-radius: 8px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,.06);">

    <h1 style="font-size: 20px; color: #2c3e50; margin: 0 0 4px;">Weekly portfolio digest</h1>
    <p style="margin: 0 0 20px; color: #888;">{{ total }} item{% if total != 1 %}s{% endif %} this week. Review at your pace.</p>

    {% for rule, items in groups.items() %}
    <h2 style="font-size: 15px; color: #2c3e50; margin: 24px 0 8px; padding-bottom: 6px; border-bottom: 1px solid #eee;">
      {{ rule.replace('_', ' ')|title }} <span style="color:#888; font-weight: 400;">({{ items|length }})</span>
    </h2>
    <ul style="margin: 0; padding-left: 20px; color: #555;">
      {% for a in items %}
      <li style="margin-bottom: 6px;">
        <strong style="color: #2c3e50;">{{ a.symbol }}</strong> — {{ a.body }}
        {% if a.payload.position_pct is defined %}
        ({{ "{:.1%}".format(a.payload.position_pct) }} of portfolio)
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endfor %}

    <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee; font-size: 12px; color: #999;">
      Portfolio Monitor · This is informational, not advice.
    </div>
  </div>
</body>
</html>
