<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ alert.title }}</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f7f7f7; margin: 0; padding: 20px;">
  <div style="max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,.06);">

    <div style="display: inline-block; padding: 4px 10px; border-radius: 4px; color: #fff; font-size: 12px; font-weight: 600; background: {% if severity == 'high' %}#c0392b{% elif severity == 'medium' %}#d68910{% else %}#34495e{% endif %};">
      {{ severity|upper }}
    </div>
    <span style="margin-left: 8px; font-size: 12px; color: #888;">{{ alert.rule|humanize_rule }}</span>

    <h1 style="margin: 12px 0 8px; font-size: 22px; color: #2c3e50;">{{ alert.title }}</h1>
    <p style="margin: 0 0 16px; color: #555;">{{ alert.body }}</p>

    {# Position context block — present for sell-into-strength and capitulation #}
    {% set p = alert.payload %}
    {% if p.market_value is defined and p.market_value %}
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 14px;">
      {% if p.day_return_pct is defined and p.day_return_pct is not none %}
      <tr>
        <td style="padding: 6px 0; color: #888;">Day change</td>
        <td style="padding: 6px 0; text-align: right; font-weight: 600;
             color: {% if p.day_return_pct >= 0 %}#27ae60{% else %}#c0392b{% endif %};">
          {{ "{:+.2%}".format(p.day_return_pct) }}
          {% if p.day_value_change is defined and p.day_value_change is not none %}
          &nbsp;·&nbsp;{{ p.day_value_change | signed_dollar }}
          {% endif %}
        </td>
      </tr>
      {% endif %}
      <tr>
        <td style="padding: 6px 0; color: #888;">Position value</td>
        <td style="padding: 6px 0; text-align: right; font-weight: 600;">${{ "{:,.0f}".format(p.market_value) }}</td>
      </tr>
      {% if p.cost_basis is defined %}
      <tr>
        <td style="padding: 6px 0; color: #888;">Cost basis</td>
        <td style="padding: 6px 0; text-align: right;">${{ "{:,.0f}".format(p.cost_basis) }}</td>
      </tr>
      {% endif %}
      {% if p.unrealized_pl_pct is defined %}
      <tr>
        <td style="padding: 6px 0; color: #888;">Unrealized P&amp;L</td>
        <td style="padding: 6px 0; text-align: right; color: {% if p.unrealized_pl_pct < 0 %}#c0392b{% else %}#27ae60{% endif %}; font-weight: 600;">
          {{ "{:+.0%}".format(p.unrealized_pl_pct) }} ({{ "+" if p.unrealized_pl >= 0 else "-" }}${{ "{:,.0f}".format(p.unrealized_pl | abs) }})
        </td>
      </tr>
      {% endif %}
      {% if p.price is defined %}
      <tr>
        <td style="padding: 6px 0; color: #888;">Last price</td>
        <td style="padding: 6px 0; text-align: right;">${{ "{:,.2f}".format(p.price) }}</td>
      </tr>
      {% endif %}
    </table>
    {% endif %}

    {# Triggers list — used by sell-into-strength #}
    {% if p.triggers is defined and p.triggers %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">Triggers</h3>
    <ul style="margin: 0; padding-left: 20px; color: #555;">
      {% for t in p.triggers %}
      <li>{{ t }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {# Deterioration signals — used by capitulation, weakness rules #}
    {% if p.deterioration_signals is defined and p.deterioration_signals %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">Fundamentals deteriorating</h3>
    <ul style="margin: 0; padding-left: 20px; color: #555;">
      {% for s in p.deterioration_signals %}
      <li>{{ s }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {# ── Technical pulse block — top_up_compounder (Phase 2) ── #}
    {% if p.technical_tier is defined %}
    {% set tier_colors = {
      'SCREAMING_BUY': '#c0392b',
      'STRONG_DIP':    '#e67e22',
      'HEALTHY_DIP':   '#27ae60',
      'TREND_CAUTION': '#7f8c8d'
    } %}
    {% set tier_labels = {
      'SCREAMING_BUY': 'Strong Entry',
      'STRONG_DIP':    'Good Entry',
      'HEALTHY_DIP':   'Normal Dip',
      'TREND_CAUTION': 'Trend Caution'
    } %}
    <div style="background: #f8f9fa; border-radius: 6px; padding: 14px 16px; margin: 0 0 16px; border-left: 4px solid {{ tier_colors.get(p.technical_tier, '#888') }};">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px; flex-wrap: wrap;">
        <span style="background: {{ tier_colors.get(p.technical_tier, '#888') }}; color: #fff; padding: 3px 10px; border-radius: 4px; font-size: 12px; font-weight: 700; letter-spacing: .3px;">
          {{ tier_labels.get(p.technical_tier, p.technical_tier) }}
        </span>
        <span style="font-size: 13px; color: #555; font-weight: 600;">What the chart is telling you</span>
      </div>
      <p style="margin: 0 0 12px; font-size: 13px; color: #444; line-height: 1.5;">{{ p.technical_summary }}</p>

      {# Visual: where is the price in the 20-day range? #}
      {% if p.bb_pct_b is defined and p.bb_pct_b is not none %}
      {% if p.bb_pct_b < 0 %}{% set bb_pos = 0 %}
      {% elif p.bb_pct_b > 1 %}{% set bb_pos = 100 %}
      {% else %}{% set bb_pos = (p.bb_pct_b * 100) | int %}{% endif %}
      <div style="margin-bottom: 10px;">
        <div style="font-size: 11px; color: #999; margin-bottom: 3px;">20-day price range position (0 = floor, 100 = ceiling)</div>
        <div style="position: relative; height: 8px; border-radius: 4px; background: linear-gradient(to right, #27ae60 0%, #f39c12 50%, #c0392b 100%);">
          <div style="position: absolute; top: -4px; width: 16px; height: 16px; background: #2c3e50; border-radius: 50%; border: 2px solid #fff; left: {{ bb_pos }}%; transform: translateX(-50%);"></div>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 10px; color: #aaa; margin-top: 4px;">
          <span>Floor{% if p.bb_lower %} ${{ "{:,.0f}".format(p.bb_lower) }}{% endif %}</span>
          <span>Mid</span>
          <span>Ceiling{% if p.bb_upper %} ${{ "{:,.0f}".format(p.bb_upper) }}{% endif %}</span>
        </div>
      </div>
      {% endif %}

      {# MA50/MA200 status pills #}
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        {% if p.above_ma200 is not none %}
        <span style="font-size: 11px; padding: 2px 8px; border-radius: 3px; font-weight: 600;
          background: {% if p.above_ma200 %}#e8f5e9{% else %}#fdecea{% endif %};
          color: {% if p.above_ma200 %}#2e7d32{% else %}#922b21{% endif %};">
          Long-term trend: {% if p.above_ma200 %}intact ✓{% else %}broken ✗{% endif %}{% if p.ma200 %} (${{ "{:,.0f}".format(p.ma200) }}){% endif %}
        </span>
        {% endif %}
        {% if p.above_ma50 is not none %}
        <span style="font-size: 11px; padding: 2px 8px; border-radius: 3px; font-weight: 600;
          background: {% if p.above_ma50 %}#e8f5e9{% else %}#fff8e1{% endif %};
          color: {% if p.above_ma50 %}#2e7d32{% else %}#7d4e00{% endif %};">
          Short-term: {% if p.above_ma50 %}recovering{% else %}negative (normal during dip){% endif %}{% if p.ma50 %} (${{ "{:,.0f}".format(p.ma50) }}){% endif %}
        </span>
        {% endif %}
        {% if p.rsi_14 is defined and p.rsi_14 is not none %}
        <span style="font-size: 11px; padding: 2px 8px; border-radius: 3px; font-weight: 600;
          background: {% if p.rsi_14 < 35 %}#fdecea{% elif p.rsi_14 < 50 %}#fff8e1{% else %}#f5f5f5{% endif %};
          color: {% if p.rsi_14 < 35 %}#922b21{% elif p.rsi_14 < 50 %}#7d4e00{% else %}#555{% endif %};">
          Selling gauge: {{ "{:.0f}".format(p.rsi_14) }}/100{% if p.rsi_14 < 35 %} (selling exhausted){% elif p.rsi_14 < 50 %} (selling negative){% else %} (neutral){% endif %}
        </span>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# ── MA Crossover block (Phase 4) ── #}
    {% if p.crossover_type is defined %}
    {% set is_golden = p.crossover_type == 'GOLDEN' %}
    <div style="background: {% if is_golden %}#e8f5e9{% else %}#fdecea{% endif %}; border-radius: 6px; padding: 14px 16px; margin: 0 0 16px;
         border-left: 4px solid {% if is_golden %}#27ae60{% else %}#c0392b{% endif %};">
      <div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;
           color: {% if is_golden %}#1b5e20{% else %}#7f0000{% endif %};">
        {% if is_golden %}✅ Recovery confirmed{% else %}⚠️ Selling pressure building{% endif %}
      </div>
      <p style="margin: 0 0 12px; font-size: 13px; color: #444; line-height: 1.5;">{{ p.crossover_summary }}</p>
      <table style="font-size: 13px; border-collapse: collapse;">
        {% if p.price %}
        <tr>
          <td style="padding: 3px 12px 3px 0; color: #888;">Current price</td>
          <td style="padding: 3px 0; font-weight: 700;">${{ "{:,.2f}".format(p.price) }}</td>
        </tr>
        {% endif %}
        {% if p.ma50 %}
        <tr>
          <td style="padding: 3px 12px 3px 0; color: #888;">50-day average</td>
          <td style="padding: 3px 0; font-weight: 600;">${{ "{:,.0f}".format(p.ma50) }}</td>
        </tr>
        {% endif %}
        {% if p.ma200 %}
        <tr>
          <td style="padding: 3px 12px 3px 0; color: #888;">200-day average</td>
          <td style="padding: 3px 0; font-weight: 600;">${{ "{:,.0f}".format(p.ma200) }}</td>
        </tr>
        {% endif %}
        {% if p.gap_pct is not none %}
        <tr>
          <td style="padding: 3px 12px 3px 0; color: #888;">Gap (50d vs 200d)</td>
          <td style="padding: 3px 0; font-weight: 600;
               color: {% if p.gap_pct >= 0 %}#27ae60{% else %}#c0392b{% endif %};">
            {{ "{:+.1%}".format(p.gap_pct) }}
          </td>
        </tr>
        {% endif %}
      </table>
    </div>
    {% endif %}

    {# Buy-the-dip / top-up stats #}
    {% if p.off_high_pct is defined %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">Dip metrics</h3>
    <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 12px;">
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Entry price</td>
        <td style="padding:6px 4px; text-align:right; font-weight:700; font-size:16px; border-bottom:1px solid #eee;">${{ "{:,.2f}".format(p.price) }}</td>
      </tr>
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">52w high</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">${{ "{:,.2f}".format(p.fifty_two_week_high) }}</td>
      </tr>
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Off high</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; color:#c0392b; border-bottom:1px solid #eee;">{{ "{:.0%}".format(p.off_high_pct) }}</td>
      </tr>
      {% if p.analyst_target is defined and p.analyst_target %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Analyst target</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee; color:#27ae60; font-weight:600;">
          ${{ "{:,.2f}".format(p.analyst_target) }}
          <span style="color:#888; font-weight:normal; margin-left:4px;">({{ "{:+.0%}".format((p.analyst_target - p.price) / p.price) }} upside)</span>
        </td>
      </tr>
      {% endif %}
      {% if p.trailing_pe is defined and p.trailing_pe %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Trailing P/E</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">{{ "{:.0f}".format(p.trailing_pe) }}x</td>
      </tr>
      {% endif %}
      {% if p.forward_pe is defined and p.forward_pe %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Forward P/E</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; border-bottom:1px solid #eee;">{{ "{:.0f}".format(p.forward_pe) }}x</td>
      </tr>
      {% endif %}
      {% if p.revenue_yoy is defined and p.revenue_yoy is not none %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Revenue YoY</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; border-bottom:1px solid #eee;
             color:{% if p.revenue_yoy >= 0 %}#27ae60{% else %}#c0392b{% endif %};">{{ "{:+.0%}".format(p.revenue_yoy) }}</td>
      </tr>
      {% endif %}
      {% if p.op_margin is defined and p.op_margin is not none %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Op margin</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">{{ "{:.0%}".format(p.op_margin) }}</td>
      </tr>
      {% endif %}
      {% if p.rsi_14 is defined %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888;">RSI(14)</td>
        <td style="padding:6px 4px; text-align:right;">{{ "{:.0f}".format(p.rsi_14) }}</td>
      </tr>
      {% endif %}
    </table>

    {% if p.news_headlines is defined and p.news_headlines %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">Why is it down? — recent headlines</h3>
    <ul style="margin: 0 0 12px; padding-left: 18px; color: #555; font-size: 13px; line-height: 1.6;">
      {% for h in p.news_headlines %}
      {% if h.title %}
      <li><a href="{{ h.url or '#' }}" style="color: #2980b9; text-decoration:none;">{{ h.title }}</a>
        {% if h.publisher %}<span style="color:#aaa; font-size:11px;"> — {{ h.publisher }}</span>{% endif %}
      </li>
      {% endif %}
      {% endfor %}
    </ul>
    {% endif %}

    {% endif %}

    {# ATH proximity stats — ath_proximity rule #}
    {% if p.ath is defined and p.ath %}
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 14px;">
      <tr>
        <td style="padding: 6px 0; color: #888;">Current price</td>
        <td style="padding: 6px 0; text-align: right; font-weight: 700;">${{ "{:,.2f}".format(p.price) }}</td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #888;">All-time high</td>
        <td style="padding: 6px 0; text-align: right;">
          ${{ "{:,.2f}".format(p.ath) }}
          <span style="margin-left: 6px; color: #e67e22; font-weight: 600;">{{ "{:.0%}".format(p.ath_pct) }} of ATH</span>
        </td>
      </tr>
      {% if p.fifty_two_week_high is defined and p.fifty_two_week_high %}
      <tr>
        <td style="padding: 6px 0; color: #888;">52-week high</td>
        <td style="padding: 6px 0; text-align: right; color: #888;">${{ "{:,.2f}".format(p.fifty_two_week_high) }}</td>
      </tr>
      {% endif %}
      <tr>
        <td style="padding: 6px 0; color: #888;">Gap to ATH</td>
        <td style="padding: 6px 0; text-align: right; color: #888;">${{ "{:,.2f}".format(p.gap_to_ath) }} per share</td>
      </tr>
    </table>
    {% endif %}

    {# Stock snapshot — exit_watchlist / sell_into_strength rules #}
    {% if p.lots is defined and (p.trailing_pe is defined or p.forward_pe is defined or p.rsi_14 is defined) %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 20px 0 6px;">Stock snapshot</h3>
    <table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 12px;">
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Price</td>
        <td style="padding:6px 4px; text-align:right; font-weight:700; border-bottom:1px solid #eee;">${{ "{:,.2f}".format(p.price) }}</td>
      </tr>
      {% if p.fifty_two_week_high is defined and p.fifty_two_week_high %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">52w high</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">
          ${{ "{:,.2f}".format(p.fifty_two_week_high) }}
          <span style="color:#888; font-size:12px; margin-left:4px;">({{ "{:+.0%}".format((p.price / p.fifty_two_week_high) - 1) }} from high)</span>
        </td>
      </tr>
      {% endif %}
      {% if p.rsi_14 is defined and p.rsi_14 is not none %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">RSI(14)</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; border-bottom:1px solid #eee;
            color:{% if p.rsi_14 >= 70 %}#c0392b{% elif p.rsi_14 <= 35 %}#27ae60{% else %}#333{% endif %};">
          {{ "{:.0f}".format(p.rsi_14) }}
          {% if p.rsi_14 >= 70 %} 🔴 overbought{% elif p.rsi_14 <= 35 %} 🟢 oversold{% endif %}
        </td>
      </tr>
      {% endif %}
      {% if p.trailing_pe is defined and p.trailing_pe %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Trailing P/E</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">{{ "{:.0f}".format(p.trailing_pe) }}x</td>
      </tr>
      {% endif %}
      {% if p.forward_pe is defined and p.forward_pe %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Forward P/E</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; border-bottom:1px solid #eee;">{{ "{:.0f}".format(p.forward_pe) }}x</td>
      </tr>
      {% endif %}
      {% if p.revenue_yoy is defined and p.revenue_yoy is not none %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Revenue YoY</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; border-bottom:1px solid #eee;
            color:{% if p.revenue_yoy >= 0 %}#27ae60{% else %}#c0392b{% endif %};">{{ "{:+.0%}".format(p.revenue_yoy) }}</td>
      </tr>
      {% endif %}
      {% if p.op_margin is defined and p.op_margin is not none %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Op margin</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">{{ "{:.0%}".format(p.op_margin) }}</td>
      </tr>
      {% endif %}
      {% if p.analyst_target is defined and p.analyst_target %}
      <tr>
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Analyst target</td>
        <td style="padding:6px 4px; text-align:right; border-bottom:1px solid #eee;">
          <span style="font-weight:600;">${{ "{:,.2f}".format(p.analyst_target) }}</span>
          <span style="color:#888; font-size:12px; margin-left:4px;">({{ "{:+.0%}".format((p.analyst_target - p.price) / p.price) }})</span>
          {% if p.analyst_target_low is defined and p.analyst_target_high is defined and p.analyst_target_low and p.analyst_target_high %}
          <span style="color:#aaa; font-size:11px; display:block;">range ${{ "{:,.0f}".format(p.analyst_target_low) }}–${{ "{:,.0f}".format(p.analyst_target_high) }}</span>
          {% endif %}
        </td>
      </tr>
      {% endif %}
      {% if p.analyst_recommendation is defined and p.analyst_recommendation %}
      <tr style="background:#fafafa;">
        <td style="padding:6px 4px; color:#888; border-bottom:1px solid #eee;">Consensus</td>
        <td style="padding:6px 4px; text-align:right; font-weight:600; border-bottom:1px solid #eee;
            color:{% if 'buy' in p.analyst_recommendation %}#27ae60{% elif 'sell' in p.analyst_recommendation %}#c0392b{% else %}#888{% endif %};">
          {{ p.analyst_recommendation.replace('_', ' ').title() }}
          {% if p.analyst_count is defined and p.analyst_count %}<span style="color:#aaa; font-weight:normal; font-size:11px;"> ({{ p.analyst_count }} analysts)</span>{% endif %}
        </td>
      </tr>
      {% endif %}
    </table>

    {# EPS beat/miss history #}
    {% if p.eps_history is defined and p.eps_history %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">EPS history — last 4 quarters</h3>
    <table style="width:100%; border-collapse:collapse; font-size:13px; margin-bottom:12px;">
      <tr style="background:#f0f0f0; font-size:11px; color:#666;">
        <th style="padding:4px 6px; text-align:left; font-weight:600;">Quarter</th>
        <th style="padding:4px 6px; text-align:right; font-weight:600;">Est.</th>
        <th style="padding:4px 6px; text-align:right; font-weight:600;">Actual</th>
        <th style="padding:4px 6px; text-align:right; font-weight:600;">Surprise</th>
      </tr>
      {% for q in p.eps_history %}
      <tr style="{% if loop.index is odd %}background:#fafafa;{% endif %}">
        <td style="padding:4px 6px; color:#555; border-bottom:1px solid #eee;">{{ q.period }}</td>
        <td style="padding:4px 6px; text-align:right; color:#888; border-bottom:1px solid #eee;">
          {% if q.estimate is not none %}${{ "{:.2f}".format(q.estimate) }}{% else %}—{% endif %}
        </td>
        <td style="padding:4px 6px; text-align:right; font-weight:600; border-bottom:1px solid #eee;
            color:{% if q.actual is not none and q.estimate is not none and q.actual >= q.estimate %}#27ae60{% else %}#c0392b{% endif %};">
          {% if q.actual is not none %}${{ "{:.2f}".format(q.actual) }}{% else %}—{% endif %}
        </td>
        <td style="padding:4px 6px; text-align:right; font-weight:600; border-bottom:1px solid #eee;
            color:{% if q.surprise_pct is not none and q.surprise_pct >= 0 %}#27ae60{% else %}#c0392b{% endif %};">
          {% if q.surprise_pct is not none %}{{ "{:+.0f}".format(q.surprise_pct) }}%{% else %}—{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}

    {# Recent news headlines #}
    {% if p.news_headlines is defined and p.news_headlines %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">Recent headlines</h3>
    <ul style="margin: 0 0 12px; padding-left: 18px; color: #555; font-size: 13px; line-height: 1.6;">
      {% for h in p.news_headlines %}
      {% if h.title %}
      <li><a href="{{ h.url or '#' }}" style="color: #2980b9; text-decoration:none;">{{ h.title }}</a>
        {% if h.publisher %}<span style="color:#aaa; font-size:11px;"> — {{ h.publisher }}</span>{% endif %}
      </li>
      {% endif %}
      {% endfor %}
    </ul>
    {% endif %}
    {% endif %}

    {# Lot breakdown — exit_watchlist rule #}
    {% if p.lots is defined and p.lots %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 20px 0 8px;">Tax lot breakdown</h3>

    {# Green banner — long-term profitable lots available #}
    {% if p.has_lt_profitable_lots %}
    <div style="background: #e8f5e9; border-left: 4px solid #27ae60; padding: 10px 14px; border-radius: 4px; font-size: 13px; color: #1b5e20; margin-bottom: 10px;">
      <strong>{{ p.lt_profitable_qty | int }} long-term profitable shares</strong> available to sell LTCG-eligible —
      estimated gain <strong>{{ p.lt_profitable_gain | signed_dollar }}</strong>
    </div>
    {% endif %}

    {# Orange banner — entire position is short-term #}
    {% if p.all_short_term %}
    <div style="background: #fff8e1; border-left: 4px solid #f39c12; padding: 10px 14px; border-radius: 4px; font-size: 13px; color: #7d4e00; margin-bottom: 10px;">
      ⚠️ <strong>All lots are short-term</strong> — selling now triggers <strong>ordinary income tax (~20–37%)</strong> instead of the 15% long-term rate.
      {% if p.earliest_lt_date %}
      Earliest lot becomes long-term on <strong>{{ p.earliest_lt_date }}</strong>
      ({{ p.days_to_earliest_lt }} day{{ 's' if p.days_to_earliest_lt != 1 else '' }} away).
      Consider waiting unless the gain justifies the tax cost.
      {% endif %}
    </div>
    {% endif %}

    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px;">
      <thead>
        <tr style="background: #f5f5f5; color: #555;">
          <th style="padding: 6px 8px; text-align: left; font-weight: 600;">Acquired</th>
          <th style="padding: 6px 8px; text-align: right; font-weight: 600;">Shares</th>
          <th style="padding: 6px 8px; text-align: right; font-weight: 600;">Cost</th>
          <th style="padding: 6px 8px; text-align: right; font-weight: 600;">Gain/sh</th>
          <th style="padding: 6px 8px; text-align: right; font-weight: 600;">Total gain</th>
          <th style="padding: 6px 8px; text-align: center; font-weight: 600;">Type</th>
        </tr>
      </thead>
      <tbody>
        {% for lot in p.lots %}
        <tr style="border-bottom: 1px solid #eee; {% if lot.is_long_term and lot.is_profitable %}background: #f9fff9;{% elif not lot.is_profitable %}background: #fff8f8;{% elif not lot.is_long_term %}background: #fffdf4;{% endif %}">
          <td style="padding: 6px 8px; color: #555;">{{ lot.acquired_on }} <span style="color:#aaa; font-size:11px;">({{ lot.days_held }}d)</span></td>
          <td style="padding: 6px 8px; text-align: right;">{{ "{:,.0f}".format(lot.quantity) }}</td>
          <td style="padding: 6px 8px; text-align: right; color: #888;">${{ "{:,.2f}".format(lot.cost_per_share) }}</td>
          <td style="padding: 6px 8px; text-align: right; font-weight: 600;
               color: {% if lot.gain_per_share >= 0 %}#27ae60{% else %}#c0392b{% endif %};">
            {{ lot.gain_per_share | signed_dollar(2) }} ({{ "{:+.0%}".format(lot.gain_pct) }})
          </td>
          <td style="padding: 6px 8px; text-align: right; font-weight: 700;
               color: {% if lot.gain_total >= 0 %}#27ae60{% else %}#c0392b{% endif %};">
            {{ lot.gain_total | signed_dollar }}
          </td>
          <td style="padding: 6px 8px; text-align: center;">
            {% if lot.is_long_term %}
            <span style="background: #e8f5e9; color: #2e7d32; padding: 2px 6px; border-radius: 3px; font-size: 11px; font-weight: 600;">LONG TERM</span>
            {% if lot.is_profitable %}
            <br><span style="color: #888; font-size: 10px;">tax ~${{ "{:,.0f}".format(lot.est_tax) }} ({{ "{:.0%}".format(lot.tax_rate) }})</span>
            {% endif %}
            {% else %}
            <span style="background: #fff3e0; color: #e65100; padding: 2px 6px; border-radius: 3px; font-size: 11px; font-weight: 600;">SHORT TERM</span>
            <br><span style="color: #999; font-size: 10px;">LT on {{ lot.lt_eligible_on }}&nbsp;({{ lot.days_to_lt }}d)</span>
            {% if lot.is_profitable %}
            <br><span style="color: #e65100; font-size: 10px;">tax ~${{ "{:,.0f}".format(lot.est_tax) }} ({{ "{:.0%}".format(lot.tax_rate) }})</span>
            {% endif %}
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {# Tax implications summary #}
    {% if p.lt_rate is defined %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 8px;">Tax implications if you sell</h3>
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 8px;">
      {% if p.has_lt_profitable_lots %}
      <tr style="background: #f9fff9; border-bottom: 1px solid #eee;">
        <td style="padding: 8px 10px; color: #2e7d32; font-weight: 600;">Long-term lots ({{ "{:.0%}".format(p.lt_rate) }} LTCG)</td>
        <td style="padding: 8px 10px; text-align: right; color: #555;">Gross gain</td>
        <td style="padding: 8px 10px; text-align: right; font-weight: 600; color: #27ae60;">{{ p.lt_gross | signed_dollar }}</td>
      </tr>
      <tr style="background: #f9fff9; border-bottom: 1px solid #eee;">
        <td style="padding: 4px 10px;"></td>
        <td style="padding: 4px 10px; text-align: right; color: #888;">Est. tax</td>
        <td style="padding: 4px 10px; text-align: right; color: #c0392b;">−${{ "{:,.0f}".format(p.lt_tax) }}</td>
      </tr>
      <tr style="background: #f9fff9; border-bottom: 2px solid #c8e6c9;">
        <td style="padding: 4px 10px;"></td>
        <td style="padding: 4px 10px; text-align: right; color: #555; font-weight: 600;">After-tax gain</td>
        <td style="padding: 4px 10px; text-align: right; font-weight: 700; color: #27ae60;">{{ p.lt_after_tax | signed_dollar }}</td>
      </tr>
      {% endif %}
      {% if p.has_st_profitable %}
      <tr style="background: #fffdf4; border-bottom: 1px solid #eee;">
        <td style="padding: 8px 10px; color: #e65100; font-weight: 600;">Short-term lots ({{ "{:.0%}".format(p.st_rate) }} ordinary income)</td>
        <td style="padding: 8px 10px; text-align: right; color: #555;">Gross gain</td>
        <td style="padding: 8px 10px; text-align: right; font-weight: 600; color: #27ae60;">{{ p.st_gross | signed_dollar }}</td>
      </tr>
      <tr style="background: #fffdf4; border-bottom: 1px solid #eee;">
        <td style="padding: 4px 10px;"></td>
        <td style="padding: 4px 10px; text-align: right; color: #888;">Est. tax</td>
        <td style="padding: 4px 10px; text-align: right; color: #c0392b;">−${{ "{:,.0f}".format(p.st_tax) }}</td>
      </tr>
      <tr style="background: #fffdf4; border-bottom: 2px solid #ffe0b2;">
        <td style="padding: 4px 10px;"></td>
        <td style="padding: 4px 10px; text-align: right; color: #555; font-weight: 600;">After-tax gain</td>
        <td style="padding: 4px 10px; text-align: right; font-weight: 700; color: #e65100;">{{ p.st_after_tax | signed_dollar }}</td>
      </tr>
      {% endif %}
    </table>
    <p style="font-size: 11px; color: #aaa; margin: 0 0 16px;">Rates from config.yaml (lt={{ "{:.0%}".format(p.lt_rate) }}, st={{ "{:.0%}".format(p.st_rate) }}). Federal only — adjust for state tax.</p>
    {% endif %}

    {% endif %}

    {# Headlines #}
    {% if p.headlines is defined and p.headlines %}
    <h3 style="font-size: 14px; color: #2c3e50; margin: 16px 0 6px;">Recent headlines</h3>
    <ul style="margin: 0; padding-left: 20px; color: #555;">
      {% for h in p.headlines[:3] %}
      <li><a href="{{ h.url or '#' }}" style="color: #2980b9;">{{ h.title }}</a> <span style="color:#aaa;">— {{ h.publisher or '' }}</span></li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if p.headlines is defined and p.headlines %}{% endif %}

    {% if p.compliance is defined and p.compliance %}
    {% set c = p.compliance %}
    <div style="margin-top: 16px; padding: 10px 14px; border-radius: 4px; font-size: 12px; font-weight: 600;
         background: {% if c.critical %}#fdecea{% elif c.warning %}#fff8e1{% else %}#e8f5e9{% endif %};
         border-left: 4px solid {% if c.critical %}#c0392b{% elif c.warning %}#f39c12{% else %}#27ae60{% endif %};
         color: {% if c.critical %}#922b21{% elif c.warning %}#7d6608{% else %}#1a5e34{% endif %};">
      Trade Compliance · {{ c.quarter.replace('_', ' ') }}: {{ c.used }} of {{ c.limit }} block trades used · {{ c.remaining }} remaining
      {% if c.critical %} ⚠️ CRITICAL — near quarterly limit{% elif c.warning %} ⚠️ WARNING — 80%+ used{% endif %}
    </div>
    {% endif %}

    <div style="margin-top: 16px;">
      <a href="http://localhost:8765/second-opinion?symbol={{ alert.symbol }}&rule={{ alert.rule }}&date={{ alert.fired_at.strftime('%Y-%m-%d') }}"
         style="display: inline-block; padding: 8px 14px; border-radius: 4px; background: #2c3e50; color: #fff; font-size: 13px; font-weight: 600; text-decoration: none;">
        Get a Second Opinion →
      </a>
    </div>

    <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee; font-size: 12px; color: #999;">
      Portfolio Monitor · {{ alert.fired_at.strftime('%Y-%m-%d %H:%M UTC') }} · Tier: {{ p.tier or 'n/a' }}
      <br>This is an alert, not advice. Review tier assignments quarterly.
    </div>
  </div>
</body>
</html>
